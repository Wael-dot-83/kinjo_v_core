# Database
# Preferred (Docker/Compose): PostgreSQL
DATABASE_URL=postgresql+psycopg2://kinjo:kinjo_password@db:5432/kinjo_db

# Optional local-only fallback (SQLite)
# DATABASE_URL=sqlite:///./data/kinjo.db

# Security
# SECRET_KEY is REQUIRED — no default. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_NAME=KinJo
ENVIRONMENT=development
DEBUG=True
TESTING=false

# Localization
DEFAULT_LANGUAGE=ar
# Note: SUPPORTED_LANGUAGES uses default value ["ar", "en"]
# Only set this if you need to override. If set, use JSON array format: SUPPORTED_LANGUAGES=["ar","en","fr"]

# Business Rules
MIN_CHILD_AGE_DAYS=70
MAX_CHILD_AGE_MONTHS=56
WAITLIST_OFFER_EXPIRY_HOURS=48

# Jordan-specific
JORDAN_PHONE_PATTERN=^(\+962|00962|0)[0-9]{9}$

# ===== PRODUCTION GATES =====
# All three settings below are enforced by validate_production_settings().
# When ENVIRONMENT=production, startup will fail (RuntimeError) if any of these
# are wrong.
#
# Set when deploying to production:
# ENVIRONMENT=production
# DEBUG=False
# API_DOCS_ENABLED=False

# Whether to expose /docs and /redoc (OpenAPI)
API_DOCS_ENABLED=True

# ===== CORS / TRUSTED HOSTS =====
# Comma-separated list. Supports JSON array or plain comma-separated values.
# Example: CORS_ALLOWED_ORIGINS=https://kinjo.example.com,https://www.kinjo.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Allowed Host header values (TrustedHostMiddleware).
# Example: TRUSTED_HOSTS=kinjo.example.com,www.kinjo.example.com
TRUSTED_HOSTS=localhost,127.0.0.1

# Cookie SameSite policy: "lax" (default) | "strict" | "none"
SESSION_COOKIE_SAMESITE=lax

# ===== SMTP (required in production) =====
# validate_production_settings() raises RuntimeError if these are empty when
# ENVIRONMENT=production.
SMTP_HOST=
SMTP_FROM=
# Optional — leave blank if your relay does not require auth
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587

# ===== OLLAMA (local LLM — optional) =====
# Used for AI-assisted KPI predictions and embedding-based search (Phase 3/5).
# Leave defaults unless you have a custom Ollama instance.
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EMBED_DIM=768
