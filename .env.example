# =============================================================================
# KinJo — Production Environment Template
# Copy to .env on your production server and fill in all required values.
# Lines marked REQUIRED must be set; others have safe defaults.
# =============================================================================

# --- Database ----------------------------------------------------------------
# REQUIRED: PostgreSQL URL. Replace credentials, host, and DB name.
DATABASE_URL=sqlite:///./data/kinjo.db
# Local SQLite fallback (development only — NOT for production):
# DATABASE_URL=sqlite:///./data/kinjo.db

# --- Security ----------------------------------------------------------------
# REQUIRED: Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex-generated-by-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080

# --- Redis -------------------------------------------------------------------
# REQUIRED for rate limiting and caching (use Docker Compose redis service)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# --- Application -------------------------------------------------------------
APP_NAME=KinJo
# REQUIRED: must be exactly "production"
ENVIRONMENT=development
# REQUIRED: must be false in production
DEBUG=false
# REQUIRED: must be false in production (hides /docs and /redoc)
API_DOCS_ENABLED=false
# REQUIRED: JSON array of allowed origins — replace with your actual domain(s)
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
# REQUIRED: JSON array of trusted hostnames
TRUSTED_HOSTS=["127.0.0.1","localhost"]
# RECOMMENDED: set to the cookie domain (e.g. ".your-domain.com")
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=kinjo_session
# RECOMMENDED: strict prevents CSRF in cross-site contexts
SESSION_COOKIE_SAMESITE=strict
CSRF_COOKIE_NAME=kinjo_csrf_token
REQUEST_TIMEOUT_SECONDS=30
PUBLIC_REGISTRATION_ENABLED=false
MFA_TOTP_ISSUER=KinJo
MFA_TICKET_EXPIRE_MINUTES=10

# --- SMTP (password reset emails) -------------------------------------------
# REQUIRED for password reset: fill all five values, then test with /api/health
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=noreply@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# --- Storage -----------------------------------------------------------------
STORAGE_PROVIDER=local
ATTACHMENTS_DIR=data/attachments
MAX_ATTACHMENT_SIZE_MB=10
UPLOADS_DIR=data/uploads
# S3 (optional — leave blank to use local storage)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# --- Notifications -----------------------------------------------------------
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false
FCM_SERVER_KEY=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=kinjo.log
# "json" emits structured JSON logs (recommended for production log aggregators);
# "text" emits human-readable lines (useful for local development).
LOG_FORMAT=json

# --- Localization ------------------------------------------------------------
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en

# --- Public contact info (shown on the Contact page / footer once set) -------
# Left blank by default — the app never fabricates contact details.
SUPPORT_CONTACT_EMAIL=
SUPPORT_CONTACT_PHONE=

# --- CAPTCHA (hCaptcha or reCAPTCHA v2) on login/register/forgot-password/contact
# Disabled by default. To enable: register a site at https://www.hcaptcha.com
# (or https://www.google.com/recaptcha/about/ for reCAPTCHA), then set:
#   CAPTCHA_ENABLED=true
#   CAPTCHA_PROVIDER=hcaptcha            # or "recaptcha"
#   CAPTCHA_SITE_KEY=<your public site key>
#   CAPTCHA_SECRET_KEY=<your private secret key>
# Startup will refuse to run in production if CAPTCHA_ENABLED=true without
# both keys set (see config.py:validate_production_settings).
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Upload virus/malware scanning (ClamAV) -----------------------------------
# Disabled by default. To enable, run a clamd daemon reachable at the host/port
# below, then set VIRUS_SCAN_ENABLED=true. When enabled, every upload is
# scanned via clamd's INSTREAM protocol; if the scanner is unreachable the
# upload is rejected (fails closed), it is never silently treated as clean.
# Startup will refuse to run in production if VIRUS_SCAN_ENABLED=true with an
# unsupported provider or no CLAMAV_HOST configured.
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Business Rules ----------------------------------------------------------
MIN_CHILD_AGE_DAYS=1
MAX_CHILD_AGE_MONTHS=56
WAITLIST_OFFER_EXPIRY_HOURS=48

# --- Database pool (PostgreSQL only) ----------------------------------------
# Tune to match your server's max_connections. Default: pool_size=10, max_overflow=20.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Session & timeouts ------------------------------------------------------
# Idle admin session timeout in minutes. Frontend redirects to /login after this.
SESSION_TIMEOUT_MINUTES=30
# Timeout (seconds) waiting for the external heatmap service before giving up.
HEATMAP_SERVICE_TIMEOUT_SECONDS=10

# --- Seed passwords ----------------------------------------------------------
# Change ALL of these before running scripts/seed_comprehensive.py in production
SEED_ADMIN_PASSWORD=ChangeMe@Admin1
SEED_MANAGER_PASSWORD=ChangeMe@Manager1
SEED_SUPERVISOR_PASSWORD=ChangeMe@Supervisor1
SEED_PARENT_PASSWORD=ChangeMe@Parent1
