# Database
# Preferred (Docker/Compose): PostgreSQL
DATABASE_URL=postgresql+psycopg2://kinjo:kinjo_password@db:5432/kinjo_db

# Optional local-only fallback (SQLite)
# DATABASE_URL=sqlite:///./data/kinjo.db

# Security
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_MESSAGES_SEND=30/minute
RATE_LIMIT_MESSAGES_LIST=60/minute
RATE_LIMIT_MESSAGES_GET=120/minute
RATE_LIMIT_MESSAGES_READ=120/minute
RATE_LIMIT_MESSAGES_REPLY=30/minute
RATE_LIMIT_MESSAGES_DELETE=30/minute
RATE_LIMIT_MESSAGES_ARCHIVE=30/minute
RATE_LIMIT_MESSAGES_UPLOAD=10/minute
RATE_LIMIT_MESSAGES_BULK=10/minute

# Application
APP_NAME=KinJo
ENVIRONMENT=development
DEBUG=True
API_DOCS_ENABLED=True
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=kinjo_session
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=kinjo_csrf_token
REQUEST_TIMEOUT_SECONDS=30
PUBLIC_REGISTRATION_ENABLED=false
MFA_TOTP_ISSUER=KinJo
MFA_TICKET_EXPIRE_MINUTES=10

# Storage
STORAGE_PROVIDER=local
ATTACHMENTS_DIR=data/attachments
MAX_ATTACHMENT_SIZE_MB=10
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# Notifications
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FCM_SERVER_KEY=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Localization
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en

# Business Rules
MIN_CHILD_AGE_DAYS=70
MAX_CHILD_AGE_MONTHS=56
WAITLIST_OFFER_EXPIRY_HOURS=48

# Jordan-specific
JORDAN_PHONE_PATTERN=^(\+962|00962|0)[0-9]{9}$

# Seed data passwords (used by scripts/seed_comprehensive.py and scripts/seed_data.py)
# Change these before seeding a production environment
SEED_ADMIN_PASSWORD=Admin@1234
SEED_MANAGER_PASSWORD=Manager@1234
SEED_SUPERVISOR_PASSWORD=Supervisor@1234
SEED_PARENT_PASSWORD=Parent@1234
