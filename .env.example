# Database
# Preferred (Docker/Compose): PostgreSQL
DATABASE_URL=postgresql+psycopg2://kinjo:kinjo_password@db:5432/kinjo_db

# Optional local-only fallback (SQLite)
# DATABASE_URL=sqlite:///./data/kinjo.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_MESSAGES_SEND=30/minute
RATE_LIMIT_MESSAGES_LIST=60/minute
RATE_LIMIT_MESSAGES_GET=120/minute
RATE_LIMIT_MESSAGES_READ=120/minute
RATE_LIMIT_MESSAGES_REPLY=30/minute
RATE_LIMIT_MESSAGES_DELETE=30/minute
RATE_LIMIT_MESSAGES_ARCHIVE=30/minute
RATE_LIMIT_MESSAGES_UPLOAD=10/minute
RATE_LIMIT_MESSAGES_BULK=10/minute

# Application
APP_NAME=KinJo
ENVIRONMENT=development
DEBUG=True

# Storage
STORAGE_PROVIDER=local
ATTACHMENTS_DIR=data/attachments
MAX_ATTACHMENT_SIZE_MB=10
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# Notifications
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_PUSH_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FCM_SERVER_KEY=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Localization
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en

# Business Rules
MIN_CHILD_AGE_DAYS=70
MAX_CHILD_AGE_MONTHS=56
WAITLIST_OFFER_EXPIRY_HOURS=48

# Jordan-specific
JORDAN_PHONE_PATTERN=^(\+962|00962|0)[0-9]{9}$
