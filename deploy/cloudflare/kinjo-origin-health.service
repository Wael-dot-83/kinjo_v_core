[Unit]
Description=KinJo — origin/edge TLS health checks
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kinjo-origin-health.sh
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kinjo-origin-health
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
