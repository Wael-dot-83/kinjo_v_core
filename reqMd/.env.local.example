# =============================================================================
# KinJo — Local Development Environment
# Copy this file to .env (project root) and adjust values as needed.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Docker Compose service name is "db"; use localhost when running without Docker
DATABASE_URL=postgresql+psycopg2://kinjo:kinjo_dev_password@localhost:5432/kinjo_db

# --- Security ----------------------------------------------------------------
# For local dev a fixed value is fine. Generate a real one for staging/prod:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=local-dev-secret-key-change-before-any-public-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Application -------------------------------------------------------------
APP_NAME=KinJo
ENVIRONMENT=development
DEBUG=true
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=kinjo_session
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=kinjo_csrf_token
REQUEST_TIMEOUT_SECONDS=30
PUBLIC_REGISTRATION_ENABLED=false
MFA_TOTP_ISSUER=KinJo
MFA_TICKET_EXPIRE_MINUTES=10

# --- SMTP (optional for local) -----------------------------------------------
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Storage -----------------------------------------------------------------
STORAGE_PROVIDER=local
ATTACHMENTS_DIR=data/attachments
MAX_ATTACHMENT_SIZE_MB=10
UPLOADS_DIR=data/uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# --- Notifications -----------------------------------------------------------
NOTIFICATIONS_PUSH_ENABLED=false
FCM_SERVER_KEY=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=kinjo.log

# --- Localization ------------------------------------------------------------
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en

# --- Business Rules ----------------------------------------------------------
# Minimum enrolment age is 1 day. 0768814 ("Change minimum child enrollment age
# from 70 days to 1 day") lowered it in config.py and child_age_policy.py but
# left the templates at the superseded 70; a value set here overrides the code
# default, so copying this file used to silently refuse children aged 1-69 days.
MIN_CHILD_AGE_DAYS=1
MAX_CHILD_AGE_MONTHS=56
WAITLIST_OFFER_EXPIRY_HOURS=48

# --- AI (optional) -----------------------------------------------------------
GOOGLE_API_KEY=

# --- Seed passwords (only used by seed scripts) ------------------------------
SEED_ADMIN_PASSWORD=Admin@Local1
SEED_MANAGER_PASSWORD=Manager@Local1
SEED_SUPERVISOR_PASSWORD=Supervisor@Local1
SEED_PARENT_PASSWORD=Parent@Local1
