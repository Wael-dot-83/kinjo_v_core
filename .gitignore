# SQLite snapshots taken before data migrations/imports. `data/*.db` above does not
# match these because the timestamp suffix falls after the extension, and SQLite's
# sidecar -shm/-wal files inherit the same full name.
data/*.db.backup-*
data/*.backup-*-shm
data/*.backup-*-wal

# Droplet-specific environment file (contains SMTP and other secrets)
.env.droplet

# Written by scripts/deploy_locked.sh on the deployed host; never committed.
# The tree digest deliberately excludes it, so it can never be self-referential.
RELEASE.json
