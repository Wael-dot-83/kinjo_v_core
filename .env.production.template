# ==============================================================
# KinJo PRODUCTION Environment — fill every REPLACE_ME value
# Copy this to .env on the production server, never commit it
# ==============================================================

ENVIRONMENT=production
TESTING=false
DEBUG=false
API_DOCS_ENABLED=false

# ------ Database (PostgreSQL required in production) ----------
# Example: postgresql://kinjo:s3cret@localhost:5432/kinjo_db
DATABASE_URL=postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:5432/REPLACE_ME_DBNAME

# ------ Redis ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/3

# ------ Security ------------------------------------------------
# DO NOT reuse the development key. Use the freshly generated key below
# (or run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=6a1a47bb478d99b9c9000d903abb948521944583f769da8b81e15423d8900d4e

# ------ JWT / Sessions ------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SAMESITE=strict

# ------ CORS / Hosts --------------------------------------------
# Replace with your actual production domain
CORS_ALLOWED_ORIGINS=["https://REPLACE_ME_DOMAIN"]
TRUSTED_HOSTS=["REPLACE_ME_DOMAIN","www.REPLACE_ME_DOMAIN"]

# ------ Email (SMTP) -------------------------------------------
SMTP_HOST=smtp.REPLACE_ME_PROVIDER.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME_EMAIL
SMTP_PASSWORD=REPLACE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@REPLACE_ME_DOMAIN
SMTP_TLS=true

# ------ Storage ------------------------------------------------
STORAGE_PROVIDER=local
ATTACHMENTS_DIR=/srv/kinjo/data/attachments
UPLOADS_DIR=/srv/kinjo/data/uploads

# ------ Application --------------------------------------------
APP_NAME=KinJo

# --- Web server ----------------------------------------------------------------
# Host port docker-compose publishes for the web container. Behind a reverse
# proxy or Cloudflare this is usually 80; leave unset for local runs (8000).
KINJO_WEB_PORT=80

