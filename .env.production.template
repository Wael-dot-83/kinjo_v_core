# ==============================================================
# KinJo PRODUCTION Environment — fill every REPLACE_ME value
# Copy this to .env on the production server, never commit it
# ==============================================================

ENVIRONMENT=production
TESTING=false
DEBUG=false
API_DOCS_ENABLED=false

# ------ Database (PostgreSQL required in production) ----------
# Example: postgresql://kinjo:s3cret@localhost:5432/kinjo_db
DATABASE_URL=postgresql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@REPLACE_ME_HOST:5432/REPLACE_ME_DBNAME

# ------ Redis ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/3

# ------ Security ------------------------------------------------
# Generate a UNIQUE key per environment — never copy one from a template, an
# example file or another server. This slot previously shipped a real 64-hex
# key, which meant every deployment that used the template as-is signed its JWTs
# and session cookies with a value published in git. That key is now permanently
# rejected at startup (see published_key_digests in config.py), as is this
# placeholder, so a forgotten REPLACE_ME fails the boot instead of going live.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME_RUN_THE_COMMAND_ABOVE

# ------ JWT / Sessions ------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER=10080
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SAMESITE=strict

# ------ CORS / Hosts --------------------------------------------
# Replace with your actual production domain
CORS_ALLOWED_ORIGINS=["https://REPLACE_ME_DOMAIN"]
TRUSTED_HOSTS=["REPLACE_ME_DOMAIN","www.REPLACE_ME_DOMAIN"]

# ------ Email (SMTP) -------------------------------------------
SMTP_HOST=smtp.REPLACE_ME_PROVIDER.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME_EMAIL
SMTP_PASSWORD=REPLACE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@REPLACE_ME_DOMAIN
SMTP_TLS=true

# ------ Storage ------------------------------------------------
STORAGE_PROVIDER=local
ATTACHMENTS_DIR=/srv/kinjo/data/attachments
UPLOADS_DIR=/srv/kinjo/data/uploads

# ------ Application --------------------------------------------
APP_NAME=KinJo

# --- Web server ----------------------------------------------------------------
# Host port docker-compose publishes for the web container. Behind a reverse
# proxy or Cloudflare this is usually 80; leave unset for local runs (8000).
KINJO_WEB_PORT=80

